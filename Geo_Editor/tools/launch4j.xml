<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>../build/GeoEditor.jar</jar>
  <outfile>../build/GeoEditor.exe</outfile>
  <errTitle>GeoEditor</errTitle>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>https://adoptium.net/</downloadUrl>
  <stayAlive>true</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <icon>../src/assets/icon/geoeditor.ico</icon>
  <classPath>
    <mainClass>com.GeoEditor</mainClass>
    <cp>libs/*</cp>
  </classPath>
  <jre>
    <path>%JAVA_HOME%;%PATH%</path>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>true</requires64Bit>
    <minVersion>25</minVersion>
    <opt>-Djava.library.path=libs</opt>
    <opt>-XX:+UseG1GC</opt>
    <opt>-XX:G1PeriodicGCInterval=5000</opt>
    <opt>-XX:MinHeapFreeRatio=10</opt>
    <opt>-XX:MaxHeapFreeRatio=20</opt>
    <opt>-XX:MaxRAMPercentage=75.0</opt>
    <opt>--enable-native-access=ALL-UNNAMED</opt>
    <opt>--add-exports=java.base/java.lang=ALL-UNNAMED</opt>
    <opt>--add-exports=java.desktop/sun.awt=ALL-UNNAMED</opt>
    <opt>--add-exports=java.desktop/sun.java2d=ALL-UNNAMED</opt>
  </jre>
  <versionInfo>
    <fileVersion>2.0.3.41</fileVersion>
    <txtFileVersion>2.0.3.41</txtFileVersion>
    <fileDescription>Lineage II Geodata Editor</fileDescription>
    <copyright>GNU General Public License v3 or later</copyright>
    <productVersion>2.0.3.41</productVersion>
    <txtProductVersion>2.0.3.41</txtProductVersion>
    <productName>L2GeoEditor</productName>
    <companyName>Maneco2</companyName>
    <internalName>GeoEditor</internalName>
    <originalFilename>GeoEditor.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
