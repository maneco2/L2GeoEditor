<?xml version="1.0" encoding="UTF-8"?>
<project name="G3DEditor Windows x64" default="dist-deflate" basedir=".">
	<property name="main" location="com.GeoEditor" />
	<property name="source.java" location="java" />
	<property name="source.runtime" location="src" />
	<property name="libs" location="libs" />
	<property name="assets" location="${source.runtime}/assets" />
	<property name="build" location="build" />
	<property name="build.classes" location="${build}/classes" />
	<property name="build.geo" location="${build}" />
	<property name="build.geo.libs" location="${build.geo}/libs" />
	<property name="build.geo.data" location="${build.geo}/data" />
	<property name="java.release" value="25" />
	<property name="java.encoding" value="UTF-8" />

	<path id="classpath">
		<fileset dir="${libs}">
			<include name="gluegen-rt.jar" />
			<include name="jogl.all.jar" />
			<include name="nativewindow.all.jar" />
		</fileset>
	</path>

	<target name="clean">
		<delete dir="${build.classes}" />
		<delete file="${build.geo}/G3DEditor.jar" quiet="true" />
		<delete file="${build.geo}/GeoEditor.jar" quiet="true" />
		<delete file="${build.geo}/G3DEditor.bat" quiet="true" />
		<delete file="${build.geo}/GeoEditor.bat" quiet="true" />
		<delete file="${build}/G3DEditor.zip" quiet="true" />
	</target>

	<target name="init" depends="clean">
		<mkdir dir="${build}" />
		<mkdir dir="${build.classes}" />
		<mkdir dir="${build.geo}" />
		<mkdir dir="${build.geo.libs}" />
		<mkdir dir="${build.geo.data}" />
	</target>

	<target name="compile" depends="init">
		<javac destdir="${build.classes}" includeantruntime="false" release="${java.release}" encoding="${java.encoding}" debug="true" verbose="false">
			<src path="${source.java}" />
			<classpath refid="classpath" />
		</javac>
	</target>

	<target name="compile-check" depends="compile" description="Compile all sources with the configured Java release." />

	<target name="jar" depends="compile">
		<jar destfile="${build.geo}/GeoEditor.jar">
			<fileset dir="${build.classes}" />
			<manifest>
				<attribute name="Main-Class" value="${main}" />
				<attribute name="Class-Path" value="." />
				<attribute name="Implementation-Title" value="L2GeoEditor" />
				<attribute name="Implementation-Version" value="2.0.3.41" />
				<attribute name="Implementation-Vendor" value="Maneco2" />
				<attribute name="Specification-Title" value="Lineage II Geodata Editor" />
				<attribute name="Specification-Version" value="2.0.3.41" />
				<attribute name="Specification-Vendor" value="Maneco2" />
				<attribute name="Built-By" value="Maneco2" />
			</manifest>
		</jar>
	</target>

	<target name="dist" depends="jar">
		<copy todir="${build.geo}">
			<fileset dir="${source.runtime}">
				<exclude name="data/**" />
			</fileset>
		</copy>
		<copy todir="${build.geo.libs}">
			<fileset dir="${libs}" />
		</copy>
		<copy todir="${build.geo.data}">
			<fileset dir="${assets}">
			</fileset>
		</copy>
	</target>

	<target name="dist-deflate" depends="dist">
		<delete dir="${build.classes}" quiet="true" />
		<delete file="${build}/G3DEditor.zip" quiet="true" />
	</target>
</project>
